# Copy to .env for local development. Never commit .env.
# All variables use the EKA_ prefix.

# local | test | dev | prod
EKA_ENVIRONMENT=local

# Required. Matches the postgres service in docker-compose.yml.
EKA_DATABASE_URL=postgresql://eka:eka@localhost:5432/eka

# DEBUG | INFO | WARNING | ERROR
EKA_LOG_LEVEL=INFO
# true = one JSON object per line (CloudWatch-friendly); false = human-readable
EKA_LOG_JSON=false

EKA_API_HOST=127.0.0.1
EKA_API_PORT=8000
