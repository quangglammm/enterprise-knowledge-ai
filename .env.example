# Copy to .env for local development. Never commit .env.
# All variables use the EKA_ prefix.

# local | test | dev | prod
EKA_ENVIRONMENT=local

# Required. Matches the postgres service in docker-compose.yml.
EKA_DATABASE_URL=postgresql://eka:eka@localhost:5432/eka
EKA_DATABASE_POOL_MIN_SIZE=1
EKA_DATABASE_POOL_MAX_SIZE=10

# Must match the vector column created by migrations (ADR-0004); checked at startup.
EKA_EMBEDDING_DIMENSION=1024

# Only for `uv run pytest -m integration`; use a database you can wipe.
EKA_TEST_DATABASE_URL=postgresql://eka:eka@localhost:5432/eka_test

# DEBUG | INFO | WARNING | ERROR
EKA_LOG_LEVEL=INFO
# true = one JSON object per line (CloudWatch-friendly); false = human-readable
EKA_LOG_JSON=false

EKA_API_HOST=127.0.0.1
EKA_API_PORT=8000
