# Copy to .env for local development. Never commit .env.
# All variables use the EKA_ prefix.

# local | test | dev | prod
EKA_ENVIRONMENT=local

# Required. Matches the postgres service in docker-compose.yml.
EKA_DATABASE_URL=postgresql://eka:eka@localhost:5432/eka
EKA_DATABASE_POOL_MIN_SIZE=1
EKA_DATABASE_POOL_MAX_SIZE=10

# Must match the vector column created by migrations (ADR-0004); checked at startup.
EKA_EMBEDDING_DIMENSION=1024

# Development-only identity from X-Tenant-ID / X-User-ID / X-User-Groups headers.
# Refused outside local and test environments.
EKA_AUTH_MODE=dev-headers

# Original uploads (S3 in AWS later)
EKA_BLOB_DIR=data/blobs
EKA_MAX_UPLOAD_BYTES=20971520

# Only for `uv run pytest -m integration`; use a database you can wipe.
EKA_TEST_DATABASE_URL=postgresql://eka:eka@localhost:5432/eka_test

# DEBUG | INFO | WARNING | ERROR
EKA_LOG_LEVEL=INFO
# true = one JSON object per line (CloudWatch-friendly); false = human-readable
EKA_LOG_JSON=false

EKA_API_HOST=127.0.0.1
EKA_API_PORT=8000

# Model providers (ADR-0010). Defaults run offline; tests never call a provider.
# Blank values mean unset. Switching embedding provider or model needs a re-upload.
EKA_EMBEDDING_PROVIDER=hashing          # hashing (dev only, no semantics) | fpt
EKA_EMBEDDING_BASE_URL=https://mkp-api.fptcloud.com
EKA_EMBEDDING_API_KEY=                  # required when EKA_EMBEDDING_PROVIDER=fpt
EKA_EMBEDDING_MODEL=Vietnamese_Embedding
EKA_LLM_BASE_URL=https://mkp-api.fptcloud.com
EKA_LLM_API_KEY=                        # set to enable POST /v1/answers
EKA_LLM_MODEL=                          # required with EKA_LLM_API_KEY, e.g. Llama-3.3-70B-Instruct
EKA_LLM_JSON_MODE=false                 # true only once the model trial confirms response_format
EKA_MODEL_MAX_ATTEMPTS=3
EKA_JOB_MAX_ATTEMPTS=3                 # ingestion job attempts, the first included (ADR-0016)
EKA_JOB_RETRY_BASE_SECONDS=10
EKA_JOB_RETRY_MAX_SECONDS=300
EKA_JOB_VISIBILITY_SECONDS=300         # must exceed the slowest ingestion
EKA_WORKER_WAIT_SECONDS=10
EKA_RETRIEVAL_MODE=vector              # vector | hybrid (full-text + vector, RRF; ADR-0014)
EKA_RRF_K=60
EKA_HYBRID_CANDIDATES=50
EKA_ANSWER_TOP_K=5
EKA_ANSWER_TIMEOUT_SECONDS=45
